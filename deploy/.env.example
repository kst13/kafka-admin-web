# 브로커 3대 전부 나열한다 (1대만 적어도 동작하지만, 그 1대 장애 시 부트스트랩이 안 된다)
KAFKA_BOOTSTRAP_SERVERS=10.0.0.11:9094,10.0.0.12:9094,10.0.0.13:9094
KAFKA_SECURITY_PROTOCOL=SASL_SSL
# username/password는 SCRAM admin 계정으로 교체한다
KAFKA_SASL_JAAS=org.apache.kafka.common.security.scram.ScramLoginModule required username="change-me" password="change-me";
KAFKA_TRUSTSTORE_LOCATION=/secrets/truststore.jks
KAFKA_TRUSTSTORE_PASSWORD=change-me

# 최초 기동 시 admin 계정 생성용 (생성 후 제거 가능)
ADMIN_INITIAL_PASSWORD=change-me

# --- Schema Registry (선택): 비워두면 스키마 메뉴가 숨겨진다. 노드를 쉼표로 나열하면 연결 실패 시 다음 노드로 넘어간다 ---
# SCHEMA_REGISTRY_URLS=http://10.0.0.11:8081,http://10.0.0.12:8081
# SCHEMA_REGISTRY_TIMEOUT_MS=5000

# --- Prometheus (선택): 비워두면 클러스터 상태 배지·브로커 상세·토픽 유입 차트(Prometheus)를 숨긴다 ---
# PROMETHEUS_URL=http://10.0.0.13:9090
# PROMETHEUS_TIMEOUT_MS=5000
# PROMETHEUS_JMX_PORT=7071
# PROMETHEUS_CACHE_SECONDS=15

# --- 감시(모니터) 설정: 미설정 시 기본값 사용 ---
# MONITOR_ENABLED=true
# MONITOR_COLLECT_INTERVAL_MS=60000
# MONITOR_LAG_THRESHOLD=1000
# MONITOR_DISK_USED_PCT_THRESHOLD=80
# MONITOR_CERT_WARN_DAYS=30
# MONITOR_COOLDOWN_MINUTES=30
# MONITOR_RETENTION_DAYS=7
# MONITOR_P99_PRODUCE_MS=1000
# MONITOR_P99_FETCH_MS=2000
# MONITOR_HANDLER_IDLE_MIN_PCT=20
# MONITOR_HEAP_USED_PCT=85
